{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sangfor.example/schemas/learning-strategy-observer/pilot-manifest.v1.json",
  "title": "Learning strategy observer pilot manifest",
  "description": "A local-only pilot attestation. PASS is valid only with confined, hashed evidence and available external dependencies.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "pilots"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "pilots": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/pilot" }
    }
  },
  "$defs": {
    "dependency": {
      "enum": ["vpn", "device", "cdp", "approval_secret", "postgres"]
    },
    "pilot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pilotId", "product", "firmwareVersion", "status", "requiredDependencies", "dependencySnapshot", "reasonCodes", "evidence"],
      "properties": {
        "pilotId": { "enum": ["cc-3.0.98", "iag-13.0.120", "fortios-8.0"] },
        "product": { "enum": ["CC", "IAG", "FORTIOS"] },
        "firmwareVersion": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "enum": ["PASS", "NOT_RUN", "BLOCKED"] },
        "requiredDependencies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/dependency" }
        },
        "dependencySnapshot": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vpn": { "enum": ["available", "unavailable"] },
            "device": { "enum": ["available", "unavailable"] },
            "cdp": { "enum": ["available", "unavailable"] },
            "approval_secret": { "enum": ["available", "unavailable"] },
            "postgres": { "enum": ["available", "unavailable"] }
          }
        },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,80}$" }
        },
        "evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "capturedAt", "kind"],
      "properties": {
        "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,240}$" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "capturedAt": { "type": "string", "format": "date-time" },
        "kind": { "enum": ["capture_bundle", "observation", "official_citation", "human_approval"] }
      }
    }
  }
}
