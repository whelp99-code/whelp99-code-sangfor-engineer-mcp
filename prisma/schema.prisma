model BlroRagEmbedding {
  tenantId    String
  projectId   String
  chunkId     String
  cohortId    String
  product     String
  version     String
  sourceType  String
  trustLevel  String
  aclActorIds String[]
  embedding   Unsupported("vector(384)")
  createdAt   DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                   @updatedAt @db.Timestamptz(3)
  tenant      BlroTenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project     BlroProject                @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  chunk       BlroRagAuthoritativeChunk  @relation(fields: [tenantId, projectId, chunkId], references: [tenantId, projectId, id], onDelete: Cascade)
  cohort      BlroRagEmbeddingCohort     @relation(fields: [tenantId, projectId, cohortId], references: [tenantId, projectId, id], onDelete: Restrict)

  @@id([tenantId, projectId, chunkId, cohortId])
  @@index([tenantId, projectId, cohortId])
  @@index([tenantId, projectId, cohortId, product, version, sourceType, trustLevel])
}
