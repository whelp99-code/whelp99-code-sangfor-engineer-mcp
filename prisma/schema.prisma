generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SangforProduct {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  priority  Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SangforManual {
  id         String   @id @default(uuid())
  product    String
  version    String?
  title      String
  sourceType String
  sourceUrl  String?
  filePath   String?
  trustLevel String   @default("needs_review")
  createdAt  DateTime @default(now())
}

model SangforProject {
  id           String   @id @default(uuid())
  customerName String
  product      String
  version      String?
  projectType  String
  status       String   @default("draft")
  createdAt    DateTime @default(now())
}

model SangforConfigPlan {
  id        String   @id @default(uuid())
  projectId String?
  product   String
  planTitle String
  planJson  Json
  riskLevel String
  status    String   @default("draft")
  createdAt DateTime @default(now())
}

model SangforFeedbackEvent {
  id           String   @id @default(uuid())
  product      String
  feedbackType String
  severity     String
  feedbackText String
  sourceRole   String
  status       String   @default("new")
  createdAt    DateTime @default(now())
}

model SangforWikiUpdateProposal {
  id         String   @id @default(uuid())
  targetPage String
  title      String
  beforeText String
  afterText  String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
}

model SangforRagDocument {
  id          String            @id @default(uuid())
  productCode String
  version     String?
  title       String
  sourceType  String
  filePath    String
  contentHash String            @unique
  createdAt   DateTime          @default(now())
  chunks      SangforRagChunk[]
}

model SangforRagChunk {
  id          String             @id @default(uuid())
  documentId  String
  productCode String
  version     String?
  title       String
  section     String?
  chunkText   String
  vector      Json?
  contentHash String             @unique
  createdAt   DateTime           @default(now())
  document    SangforRagDocument @relation(fields: [documentId], references: [id])
}

model SangforFineTuneDataset {
  id           String   @id @default(uuid())
  productCode  String
  taskType     String
  path         String
  status       String   @default("draft")
  exampleCount Int      @default(0)
  createdAt    DateTime @default(now())
}

model SangforFineTuneJob {
  id          String   @id @default(uuid())
  provider    String
  baseModel   String
  datasetPath String
  productCode String
  taskType    String
  status      String   @default("ready_for_review")
  createdAt   DateTime @default(now())
}

model LearningMethodCatalog {
  id            String   @id @default(uuid())
  code          String
  revisionId    String   @unique
  status        String
  contentDigest String
  coverage      Json?
  latencyMs     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LearningFirmwareProfile {
  id              String   @id @default(uuid())
  firmwareTruthId String   @unique
  vendor          String
  productCode     String
  productVariant  String?
  versionRaw      String
  specVersion     String?
  registryDigest  String
  uiFingerprint   String?
  apiFingerprint  String?
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LearningStrategyRevision {
  revisionId        String   @id
  strategyId        String
  state             String
  contentDigest     String
  evidenceDigest    String?
  methodCodes       Json?
  deviceScopeDigest String?
  createdAt         DateTime
  mirroredAt        DateTime @default(now())

  @@index([strategyId, createdAt])
}

model LearningLifecycleEvent {
  eventId        String   @id
  strategyId     String
  revisionId     String
  eventType      String
  fromState      String?
  toState        String
  evidenceDigest String?
  occurredAt     DateTime
  mirroredAt     DateTime @default(now())

  @@index([strategyId, occurredAt])
}

model LearningEvidence {
  evidenceId String   @id
  digest     String   @unique
  kind       String
  status     String
  coverage   Json?
  latencyMs  Int?
  createdAt  DateTime
  mirroredAt DateTime @default(now())
}

model LearningRun {
  runId             String    @id
  strategyId        String?
  revisionId        String?
  methodCode        String?
  status            String
  coverage          Json?
  latencyMs         Int?
  deviceScopeDigest String?
  startedAt         DateTime
  completedAt       DateTime?
  mirroredAt        DateTime  @default(now())
}

model LearningMirrorReceipt {
  eventId       String   @id
  eventType     String
  payloadDigest String
  status        String
  mirroredAt    DateTime
  updatedAt     DateTime @updatedAt
}

model BlroTenant {
  id                        String                         @id
  name                      String
  createdAt                 DateTime                       @default(now())
  projects                  BlroProject[]
  actors                    BlroActor[]
  roles                     BlroRole[]
  approvalNonces            BlroApprovalNonce[]
  auditEvents               BlroAuditEvent[]
  devices                   BlroDevice[]
  runs                      BlroRun[]
  steps                     BlroRunStep[]
  approvals                 BlroApproval[]
  evidenceManifests         BlroEvidenceManifest[]
  ragDocuments              BlroRagDocument[]
  ragChunks                 BlroRagChunk[]
  clientEnrollments         BlroClientEnrollment[]
  remoteJobCapabilityJtis   BlroRemoteJobCapabilityJti[]
  remoteJobs                BlroRemoteJob[]
  serviceRegistry           BlroServiceRegistry[]
  pmRecords                 BlroPmRecord[]
  feedbackLessons           BlroFeedbackLesson[]
  evalRecords               BlroEvalRecord[]
  wikiProposals             BlroWikiProposal[]
  learningRecords           BlroLearningRecord[]
  firmwareEvidence          BlroFirmwareEvidence[]
  configChronicles          BlroConfigChronicle[]
  capabilityEvidence        BlroCapabilityEvidence[]
  ragSourceChunks           BlroRagSourceChunk[]
  enrollmentIdentities      BlroEnrollmentIdentity[]
  enrollmentCertificates    BlroEnrollmentCertificate[]
  enrollmentGrants          BlroEnrollmentGrant[]
  enrollmentBootstrapTokens BlroEnrollmentBootstrapToken[]
  enrollmentRotations       BlroEnrollmentRotation[]
  localWriteIntents         BlroLocalWriteIntent[]
  ragEmbeddingCohorts       BlroRagEmbeddingCohort[]
  ragAuthoritativeChunks    BlroRagAuthoritativeChunk[]
  ragEmbeddings             BlroRagEmbedding[]
}

model BlroProject {
  id                        String                         @id
  tenantId                  String
  legacyEngagementId        String?                        @unique
  name                      String
  status                    String                         @default("active")
  createdAt                 DateTime                       @default(now())
  tenant                    BlroTenant                     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships               BlroMembership[]
  nonces                    BlroApprovalNonce[]
  auditEvents               BlroAuditEvent[]
  devices                   BlroDevice[]
  runs                      BlroRun[]
  steps                     BlroRunStep[]
  approvals                 BlroApproval[]
  evidenceManifests         BlroEvidenceManifest[]
  ragDocuments              BlroRagDocument[]
  ragChunks                 BlroRagChunk[]
  clientEnrollments         BlroClientEnrollment[]
  remoteJobCapabilityJtis   BlroRemoteJobCapabilityJti[]
  remoteJobs                BlroRemoteJob[]
  serviceRegistry           BlroServiceRegistry[]
  pmRecords                 BlroPmRecord[]
  feedbackLessons           BlroFeedbackLesson[]
  evalRecords               BlroEvalRecord[]
  wikiProposals             BlroWikiProposal[]
  learningRecords           BlroLearningRecord[]
  firmwareEvidence          BlroFirmwareEvidence[]
  configChronicles          BlroConfigChronicle[]
  capabilityEvidence        BlroCapabilityEvidence[]
  ragSourceChunks           BlroRagSourceChunk[]
  enrollmentIdentities      BlroEnrollmentIdentity[]
  enrollmentCertificates    BlroEnrollmentCertificate[]
  enrollmentGrants          BlroEnrollmentGrant[]
  enrollmentBootstrapTokens BlroEnrollmentBootstrapToken[]
  enrollmentRotations       BlroEnrollmentRotation[]
  authorityCutovers         BlroAuthorityCutover[]
  authorityEpoch            BlroProjectAuthorityEpoch?
  localWriteIntents         BlroLocalWriteIntent[]
  sourceRootOwnerships      BlroSourceRootOwner[]
  ragEmbeddingCohorts       BlroRagEmbeddingCohort[]
  ragAuthoritativeChunks    BlroRagAuthoritativeChunk[]
  ragEmbeddings             BlroRagEmbedding[]

  @@unique([id, tenantId])
  @@unique([tenantId, id])
  @@index([tenantId])
}

model BlroActor {
  id                String                 @id
  tenantId          String
  displayName       String
  actorType         String
  apiKeyDigest      String?                @unique
  apiKeyIssuedAt    DateTime?
  revokedAt         DateTime?
  createdAt         DateTime               @default(now())
  tenant            BlroTenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships       BlroMembership[]
  localWriteIntents BlroLocalWriteIntent[] @relation("LocalWriteIntentActor")

  @@unique([id, tenantId])
  @@index([tenantId])
}

model BlroRole {
  id          String           @id
  tenantId    String
  name        String
  permissions String[]
  createdAt   DateTime         @default(now())
  tenant      BlroTenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships BlroMembership[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
}

model BlroMembership {
  id                String                      @id
  tenantId          String
  projectId         String
  actorId           String
  roleId            String
  createdAt         DateTime                    @default(now())
  revokedAt         DateTime?
  project           BlroProject                 @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  actor             BlroActor                   @relation(fields: [actorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  role              BlroRole                    @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  consumedNonces    BlroApprovalNonce[]
  auditEvents       BlroAuditEvent[]
  createdDevices    BlroDevice[]
  runs              BlroRun[]
  steps             BlroRunStep[]
  approvals         BlroApproval[]
  evidenceManifests BlroEvidenceManifest[]
  ragDocuments      BlroRagDocument[]
  localWriteIntents BlroLocalWriteIntent[]      @relation("LocalWriteIntentMembership")
  ragChunks         BlroRagAuthoritativeChunk[]

  @@unique([projectId, actorId])
  @@unique([tenantId, projectId, actorId])
  @@index([actorId])
}

model BlroApprovalNonce {
  id                   String          @id
  tenantId             String
  projectId            String
  nonce                String          @unique
  expiresAt            DateTime
  consumedAt           DateTime?
  consumedByActorId    String?
  authorityEpoch       Int
  createdAt            DateTime        @default(now())
  tenant               BlroTenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project              BlroProject     @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  consumedByMembership BlroMembership? @relation(fields: [projectId, consumedByActorId], references: [projectId, actorId], onDelete: Restrict)

  @@index([expiresAt])
  @@index([projectId, authorityEpoch])
}

model BlroAuditEvent {
  id              String          @id
  tenantId        String
  projectId       String
  seq             BigInt
  at              DateTime        @default(now()) @db.Timestamptz(3)
  actorId         String?
  kind            String
  payload         Json
  prevHash        String
  hash            String
  keyed           Boolean         @default(false)
  tenant          BlroTenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project         BlroProject     @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  actorMembership BlroMembership? @relation(fields: [projectId, actorId], references: [projectId, actorId], onDelete: Restrict)

  @@unique([projectId, seq])
}

model BlroDevice {
  id                  String         @id
  tenantId            String
  projectId           String
  createdByActorId    String
  name                String
  product             String
  host                String
  metadata            Json
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  tenant              BlroTenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project             BlroProject    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  createdByMembership BlroMembership @relation(fields: [projectId, createdByActorId], references: [projectId, actorId], onDelete: Restrict)

  @@unique([projectId, name])
}

model BlroRun {
  id                 String                 @id
  tenantId           String
  projectId          String
  actorId            String
  status             String
  toolProfileVersion String
  sourceSystem       String
  authorityEpoch     Int
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  tenant             BlroTenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project            BlroProject            @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  actorMembership    BlroMembership         @relation(fields: [projectId, actorId], references: [projectId, actorId], onDelete: Restrict)
  steps              BlroRunStep[]
  evidence           BlroEvidenceManifest[]

  @@unique([id, projectId])
  @@index([projectId, createdAt])
  @@index([projectId, authorityEpoch])
}

model BlroRunStep {
  id              String         @id
  tenantId        String
  projectId       String
  runId           String
  actorId         String
  ordinal         Int
  status          String
  payload         Json
  createdAt       DateTime       @default(now())
  tenant          BlroTenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project         BlroProject    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  run             BlroRun        @relation(fields: [runId, projectId], references: [id, projectId], onDelete: Restrict)
  actorMembership BlroMembership @relation(fields: [projectId, actorId], references: [projectId, actorId], onDelete: Restrict)

  @@unique([runId, ordinal])
  @@index([projectId, createdAt])
}

model BlroApproval {
  id              String         @id
  tenantId        String
  projectId       String
  actorId         String
  actionHash      String
  expiresAt       DateTime
  status          String
  authorityEpoch  Int
  createdAt       DateTime       @default(now())
  tenant          BlroTenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project         BlroProject    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  actorMembership BlroMembership @relation(fields: [projectId, actorId], references: [projectId, actorId], onDelete: Restrict)

  @@index([projectId, actionHash])
  @@index([projectId, authorityEpoch])
}

model BlroEvidenceManifest {
  id              String         @id
  tenantId        String
  projectId       String
  actorId         String
  runId           String
  contentHash     String
  manifest        Json
  createdAt       DateTime       @default(now())
  tenant          BlroTenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project         BlroProject    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  actorMembership BlroMembership @relation(fields: [projectId, actorId], references: [projectId, actorId], onDelete: Restrict)
  run             BlroRun        @relation(fields: [runId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([projectId, contentHash])
}

model BlroRagDocument {
  id              String         @id
  tenantId        String
  projectId       String
  actorId         String
  title           String
  sourceRef       String
  contentHash     String
  provenance      Json
  createdAt       DateTime       @default(now())
  tenant          BlroTenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project         BlroProject    @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  actorMembership BlroMembership @relation(fields: [projectId, actorId], references: [projectId, actorId], onDelete: Restrict)
  chunks          BlroRagChunk[]

  @@unique([id, projectId])
  @@unique([projectId, contentHash])
}

model BlroRagChunk {
  id          String          @id
  tenantId    String
  projectId   String
  documentId  String
  text        String
  contentHash String
  vector      Json?
  aclActorIds String[]
  createdAt   DateTime        @default(now())
  tenant      BlroTenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project     BlroProject     @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  document    BlroRagDocument @relation(fields: [documentId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([projectId, contentHash])
  @@index([projectId, documentId])
}

model BlroRuntimeSchema {
  component   String   @id
  version     String
  installedAt DateTime @default(now())
}

model BlroClientEnrollment {
  id                String      @id
  tenantId          String
  projectId         String
  installationId    String
  certificateSerial String
  record            Json
  updatedAt         DateTime    @updatedAt
  tenant            BlroTenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project           BlroProject @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)

  @@unique([projectId, certificateSerial])
  @@index([projectId, installationId])
}

model BlroEnrollmentIdentity {
  id                       String                       @id
  tenantId                 String
  projectId                String
  installationId           String
  deviceBindingDigest      String
  clientIdentityId         String
  state                    String
  revision                 Int
  currentCertificateSerial String
  createdAt                DateTime
  updatedAt                DateTime
  revokedAt                DateTime?
  revocationReason         String?
  revocationRevision       Int?
  tenant                   BlroTenant                   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project                  BlroProject                  @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  certificates             BlroEnrollmentCertificate[]
  grants                   BlroEnrollmentGrant[]
  rotations                BlroEnrollmentRotation[]
  remoteJobCapabilityJtis  BlroRemoteJobCapabilityJti[]
  remoteJobs               BlroRemoteJob[]

  @@unique([id, projectId])
  @@unique([projectId, installationId])
  @@unique([tenantId, projectId, installationId])
  @@unique([projectId, clientIdentityId])
  @@index([projectId, deviceBindingDigest])
}

model BlroEnrollmentCertificate {
  id                String                 @id
  tenantId          String
  projectId         String
  enrollmentId      String
  issuerChainRef    String
  issuer            String
  subjectAltNames   String[]
  extendedKeyUsages String[]
  serial            String
  fingerprintSha256 String
  notBefore         DateTime
  notAfter          DateTime
  state             String
  revision          Int
  overlapExpiresAt  DateTime?
  acknowledgedAt    DateTime?
  revokedAt         DateTime?
  revocationReason  String?
  createdAt         DateTime
  tenant            BlroTenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project           BlroProject            @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  enrollment        BlroEnrollmentIdentity @relation(fields: [enrollmentId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([projectId, serial])
  @@unique([projectId, fingerprintSha256])
  @@index([projectId, enrollmentId, state])
}

model BlroEnrollmentGrant {
  id           String                 @id
  tenantId     String
  projectId    String
  enrollmentId String
  originDigest String
  scope        String
  revision     Int
  createdAt    DateTime
  tenant       BlroTenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project      BlroProject            @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  enrollment   BlroEnrollmentIdentity @relation(fields: [enrollmentId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([projectId, enrollmentId, originDigest, scope])
  @@index([projectId, originDigest, scope])
}

model BlroEnrollmentBootstrapToken {
  id                  String      @id
  tenantId            String
  projectId           String
  installationId      String
  deviceBindingDigest String
  tokenDigest         String
  grants              Json
  expiresAt           DateTime
  claimedAt           DateTime?
  revision            Int
  createdAt           DateTime
  tenant              BlroTenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project             BlroProject @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)

  @@unique([projectId, tokenDigest])
  @@index([projectId, installationId])
  @@index([projectId, expiresAt])
}

model BlroEnrollmentRotation {
  id                    String                 @id
  tenantId              String
  projectId             String
  enrollmentId          String
  oldSerial             String
  newSerial             String
  overlapExpiresAt      DateTime
  acknowledgedAt        DateTime?
  requestDigest         String
  acknowledgementDigest String?
  revision              Int
  createdAt             DateTime
  tenant                BlroTenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project               BlroProject            @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  enrollment            BlroEnrollmentIdentity @relation(fields: [enrollmentId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([projectId, enrollmentId, oldSerial, newSerial])
  @@unique([projectId, requestDigest])
  @@index([projectId, overlapExpiresAt])
}

model BlroRemoteJobCapabilityJti {
  jti                 String                 @id
  tenantId            String
  projectId           String
  installationId      String
  jobId               String
  requestDigest       String
  capabilityExpiresAt DateTime
  consumedAt          DateTime
  tenant              BlroTenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project             BlroProject            @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  enrollment          BlroEnrollmentIdentity @relation(fields: [tenantId, projectId, installationId], references: [tenantId, projectId, installationId], onDelete: Restrict)
  remoteJob           BlroRemoteJob?

  @@unique([jti, tenantId, projectId, installationId, jobId, requestDigest])
  @@index([projectId, installationId, jobId])
}

model BlroRemoteJob {
  id                   String                     @id
  tenantId             String
  projectId            String
  installationId       String
  jobId                String
  runId                String
  stepId               String
  requestId            String
  requestDigest        String
  capabilityJti        String                     @unique
  state                String
  authorityEpoch       Int
  result               Json?
  resultDigest         String?
  tombstoneCommittedAt DateTime
  resultCommittedAt    DateTime?
  indeterminateAt      DateTime?
  createdAt            DateTime
  updatedAt            DateTime
  tenant               BlroTenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project              BlroProject                @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  enrollment           BlroEnrollmentIdentity     @relation(fields: [tenantId, projectId, installationId], references: [tenantId, projectId, installationId], onDelete: Restrict)
  capability           BlroRemoteJobCapabilityJti @relation(fields: [capabilityJti, tenantId, projectId, installationId, jobId, requestDigest], references: [jti, tenantId, projectId, installationId, jobId, requestDigest], onDelete: Restrict)

  @@unique([tenantId, projectId, installationId, jobId])
  @@unique([tenantId, projectId, installationId, jobId, requestDigest])
  @@unique([capabilityJti, tenantId, projectId, installationId, jobId, requestDigest])
  @@index([projectId, installationId, state])
  @@index([projectId, authorityEpoch])
}

model BlroAuthorityCutover {
  projectId            String
  aggregate            String
  state                String                        @default("LOCAL_PRIMARY")
  epoch                Int                           @default(0)
  revision             Int                           @default(0)
  sourceHighWaterMark  String?
  sourceDigest         String?
  targetDigest         String?
  localWriteFencedAt   DateTime?                     @db.Timestamptz(3)
  sourceOwnerTenantId  String?
  sourceRoot           String?
  sourceDevice         String?
  sourceInode          String?
  sourceMarkerRequired Boolean                       @default(false)
  updatedAt            DateTime                      @updatedAt
  project              BlroProject                   @relation(fields: [projectId], references: [id], onDelete: Restrict)
  staging              BlroAuthorityCutoverStaging[]
  writeIntents         BlroLocalWriteIntent[]

  @@id([projectId, aggregate])
}

model BlroProjectAuthorityEpoch {
  projectId String      @id
  epoch     Int
  revision  Int         @default(0)
  updatedAt DateTime    @updatedAt @db.Timestamptz(3)
  project   BlroProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model BlroSourceRootOwner {
  sourceDevice String
  sourceInode  String
  tenantId     String
  projectId    String
  sourceRoot   String
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  project      BlroProject @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Cascade)

  @@id([sourceDevice, sourceInode])
}

model BlroLocalWriteIntent {
  writeId         String               @id
  tenantId        String
  projectId       String
  actorId         String
  aggregate       String
  epoch           Int
  sourceRoot      String
  operationDigest String
  targetPaths     Json
  beforeDigests   Json
  afterDigests    Json?
  status          String
  createdAt       DateTime             @default(now()) @db.Timestamptz(3)
  resolvedAt      DateTime?            @db.Timestamptz(3)
  tenant          BlroTenant           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project         BlroProject          @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  actor           BlroActor            @relation("LocalWriteIntentActor", fields: [actorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actorMembership BlroMembership       @relation("LocalWriteIntentMembership", fields: [tenantId, projectId, actorId], references: [tenantId, projectId, actorId], onDelete: Restrict)
  cutover         BlroAuthorityCutover @relation(fields: [projectId, aggregate], references: [projectId, aggregate], onDelete: Restrict)

  @@index([projectId, aggregate, status])
}

