generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SangforProduct {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  priority  Int
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

model SangforManual {
  id         String   @id @default(uuid())
  product    String
  version    String?
  title      String
  sourceType String
  sourceUrl  String?
  filePath   String?
  trustLevel String   @default("needs_review")
  createdAt  DateTime @default(now())
}

model SangforProject {
  id           String   @id @default(uuid())
  customerName String
  product      String
  version      String?
  projectType  String
  status       String   @default("draft")
  createdAt    DateTime @default(now())
}

model SangforConfigPlan {
  id        String   @id @default(uuid())
  projectId String?
  product   String
  planTitle String
  planJson  Json
  riskLevel String
  status    String   @default("draft")
  createdAt DateTime @default(now())
}

model SangforFeedbackEvent {
  id           String   @id @default(uuid())
  product      String
  feedbackType String
  severity     String
  feedbackText String
  sourceRole   String
  status       String   @default("new")
  createdAt    DateTime @default(now())
}

model SangforWikiUpdateProposal {
  id         String   @id @default(uuid())
  targetPage String
  title      String
  beforeText String
  afterText  String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
}

model SangforRagDocument {
  id          String            @id @default(uuid())
  productCode String
  version     String?
  title       String
  sourceType  String
  filePath    String
  contentHash String            @unique
  createdAt   DateTime          @default(now())
  chunks      SangforRagChunk[]
}

model SangforRagChunk {
  id          String             @id @default(uuid())
  documentId  String
  productCode String
  version     String?
  title       String
  section     String?
  chunkText   String
  vector      Json?
  contentHash String             @unique
  createdAt   DateTime           @default(now())
  document    SangforRagDocument @relation(fields: [documentId], references: [id])
}

model SangforFineTuneDataset {
  id           String   @id @default(uuid())
  productCode  String
  taskType     String
  path         String
  status       String   @default("draft")
  exampleCount Int      @default(0)
  createdAt    DateTime @default(now())
}

model SangforFineTuneJob {
  id          String   @id @default(uuid())
  provider    String
  baseModel   String
  datasetPath String
  productCode String
  taskType    String
  status      String   @default("ready_for_review")
  createdAt   DateTime @default(now())
}

model LearningMethodCatalog {
  id            String   @id @default(uuid())
  code          String
  revisionId    String   @unique
  status        String
  contentDigest String
  coverage      Json?
  latencyMs     Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LearningFirmwareProfile {
  id              String   @id @default(uuid())
  firmwareTruthId String   @unique
  vendor          String
  productCode     String
  productVariant  String?
  versionRaw      String
  specVersion     String?
  registryDigest  String
  uiFingerprint   String?
  apiFingerprint  String?
  status          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model LearningStrategyRevision {
  revisionId        String   @id
  strategyId        String
  state             String
  contentDigest     String
  evidenceDigest    String?
  methodCodes       Json?
  deviceScopeDigest String?
  createdAt         DateTime
  mirroredAt        DateTime @default(now())

  @@index([strategyId, createdAt])
}

model LearningLifecycleEvent {
  eventId        String   @id
  strategyId     String
  revisionId     String
  eventType      String
  fromState      String?
  toState        String
  evidenceDigest String?
  occurredAt     DateTime
  mirroredAt     DateTime @default(now())

  @@index([strategyId, occurredAt])
}

model LearningEvidence {
  evidenceId String   @id
  digest     String   @unique
  kind       String
  status     String
  coverage   Json?
  latencyMs  Int?
  createdAt  DateTime
  mirroredAt DateTime @default(now())
}

model LearningRun {
  runId             String    @id
  strategyId        String?
  revisionId        String?
  methodCode        String?
  status            String
  coverage          Json?
  latencyMs         Int?
  deviceScopeDigest String?
  startedAt         DateTime
  completedAt       DateTime?
  mirroredAt        DateTime  @default(now())
}

model LearningMirrorReceipt {
  eventId       String   @id
  eventType     String
  payloadDigest String
  status        String
  mirroredAt    DateTime
  updatedAt     DateTime @updatedAt
}

model BlroTenant {
  id        String   @id
  name      String
  createdAt DateTime @default(now())
  projects  BlroProject[]
  actors    BlroActor[]
  roles     BlroRole[]
  approvalNonces BlroApprovalNonce[]
  auditEvents BlroAuditEvent[]
  devices BlroDevice[]
  runs BlroRun[]
  steps BlroRunStep[]
  approvals BlroApproval[]
  evidenceManifests BlroEvidenceManifest[]
  ragDocuments BlroRagDocument[]
  ragChunks BlroRagChunk[]
}

model BlroProject {
  id                 String   @id
  tenantId           String
  legacyEngagementId String?  @unique
  name               String
  status             String   @default("active")
  createdAt          DateTime @default(now())
  tenant              BlroTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships         BlroMembership[]
  nonces              BlroApprovalNonce[]
  auditEvents         BlroAuditEvent[]
  devices             BlroDevice[]
  runs                BlroRun[]
  steps               BlroRunStep[]
  approvals           BlroApproval[]
  evidenceManifests   BlroEvidenceManifest[]
  ragDocuments        BlroRagDocument[]
  ragChunks           BlroRagChunk[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model BlroActor {
  id             String    @id
  tenantId       String
  displayName    String
  actorType      String
  apiKeyDigest   String?   @unique
  apiKeyIssuedAt DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  tenant         BlroTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships BlroMembership[]

  @@unique([id, tenantId])
  @@index([tenantId])
}

model BlroRole {
  id          String   @id
  tenantId    String
  name        String
  permissions String[]
  createdAt   DateTime @default(now())
  tenant      BlroTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships BlroMembership[]

  @@unique([id, tenantId])
  @@unique([tenantId, name])
}

model BlroMembership {
  id                 String    @id
  tenantId           String
  projectId          String
  actorId            String
  roleId             String
  createdAt          DateTime  @default(now())
  revokedAt          DateTime?
  project            BlroProject @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actor              BlroActor @relation(fields: [actorId, tenantId], references: [id, tenantId], onDelete: Restrict)
  role               BlroRole @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Restrict)
  consumedNonces     BlroApprovalNonce[]
  auditEvents        BlroAuditEvent[]
  createdDevices     BlroDevice[]
  runs               BlroRun[]
  steps              BlroRunStep[]
  approvals          BlroApproval[]
  evidenceManifests  BlroEvidenceManifest[]
  ragDocuments       BlroRagDocument[]

  @@unique([projectId, actorId])
  @@index([actorId])
}

model BlroApprovalNonce {
  id                String    @id
  tenantId          String
  projectId         String
  nonce             String    @unique
  expiresAt         DateTime
  consumedAt        DateTime?
  consumedByActorId String?
  createdAt         DateTime  @default(now())
  tenant            BlroTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project           BlroProject @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  consumedByMembership BlroMembership? @relation(fields: [projectId, consumedByActorId], references: [projectId, actorId], onDelete: Restrict)
  @@index([expiresAt])
}

model BlroAuditEvent {
  id        String   @id
  tenantId  String
  projectId String
  seq       BigInt
  at        DateTime @default(now())
  actorId   String?
  kind      String
  payload   Json
  prevHash  String
  hash      String
  keyed     Boolean  @default(false)
  tenant    BlroTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project   BlroProject @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actorMembership BlroMembership? @relation(fields: [projectId, actorId], references: [projectId, actorId], onDelete: Restrict)

  @@unique([projectId, seq])
}

model BlroDevice {
  id               String   @id
  tenantId         String
  projectId        String
  createdByActorId String
  name             String
  product          String
  host             String
  metadata         Json
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tenant           BlroTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project          BlroProject @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  createdByMembership BlroMembership @relation(fields: [projectId, createdByActorId], references: [projectId, actorId], onDelete: Restrict)

  @@unique([projectId, name])
}

model BlroRun {
  id                 String   @id
  tenantId           String
  projectId          String
  actorId            String
  status             String
  toolProfileVersion String
  sourceSystem       String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             BlroTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project            BlroProject @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actorMembership    BlroMembership @relation(fields: [projectId, actorId], references: [projectId, actorId], onDelete: Restrict)
  steps              BlroRunStep[]
  evidence           BlroEvidenceManifest[]

  @@unique([id, projectId])
  @@index([projectId, createdAt])
}

model BlroRunStep {
  id        String   @id
  tenantId  String
  projectId String
  runId     String
  actorId   String
  ordinal   Int
  status    String
  payload   Json
  createdAt DateTime @default(now())
  tenant    BlroTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project   BlroProject @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  run       BlroRun @relation(fields: [runId, projectId], references: [id, projectId], onDelete: Restrict)
  actorMembership BlroMembership @relation(fields: [projectId, actorId], references: [projectId, actorId], onDelete: Restrict)

  @@unique([runId, ordinal])
  @@index([projectId, createdAt])
}

model BlroApproval {
  id         String   @id
  tenantId   String
  projectId  String
  actorId    String
  actionHash String
  expiresAt  DateTime
  status     String
  createdAt  DateTime @default(now())
  tenant     BlroTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project    BlroProject @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actorMembership BlroMembership @relation(fields: [projectId, actorId], references: [projectId, actorId], onDelete: Restrict)

  @@index([projectId, actionHash])
}

model BlroEvidenceManifest {
  id          String   @id
  tenantId    String
  projectId   String
  actorId     String
  runId       String
  contentHash String
  manifest    Json
  createdAt   DateTime @default(now())
  tenant      BlroTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project     BlroProject @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actorMembership BlroMembership @relation(fields: [projectId, actorId], references: [projectId, actorId], onDelete: Restrict)
  run         BlroRun @relation(fields: [runId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([projectId, contentHash])
}

model BlroRagDocument {
  id          String   @id
  tenantId    String
  projectId   String
  actorId     String
  title       String
  sourceRef   String
  contentHash String
  provenance  Json
  createdAt   DateTime @default(now())
  tenant      BlroTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project     BlroProject @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  actorMembership BlroMembership @relation(fields: [projectId, actorId], references: [projectId, actorId], onDelete: Restrict)
  chunks      BlroRagChunk[]

  @@unique([id, projectId])
  @@unique([projectId, contentHash])
}

model BlroRagChunk {
  id          String   @id
  tenantId    String
  projectId   String
  documentId  String
  text        String
  contentHash String
  vector      Json?
  aclActorIds String[]
  createdAt   DateTime @default(now())
  tenant      BlroTenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  project     BlroProject @relation(fields: [projectId, tenantId], references: [id, tenantId], onDelete: Restrict)
  document    BlroRagDocument @relation(fields: [documentId, projectId], references: [id, projectId], onDelete: Restrict)

  @@unique([projectId, contentHash])
  @@index([projectId, documentId])
}
