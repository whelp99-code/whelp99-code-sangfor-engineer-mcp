  project     BlroProject        @relation(fields: [tenantId, projectId], references: [tenantId, id], onDelete: Restrict)
  membership  BlroMembership     @relation(fields: [tenantId, projectId, actorId], references: [tenantId, projectId, actorId], onDelete: Restrict)
  embeddings  BlroRagEmbedding[]

  @@id([tenantId, projectId, id])
  @@unique([tenantId, projectId, contentHash])
