{
  "version": 1,
  "nodes": [
    {
      "id": "search-gap-capture",
      "kind": "producer",
      "reads": [],
      "writes": [
        "data/feedback/search-gaps.jsonl"
      ],
      "note": "declared-only: lives in apps/mcp-server/src/index.ts (broad multi-concern file); weak rag_search hits append SearchGapEvent lines"
    },
    {
      "id": "gap-queries",
      "kind": "internal",
      "src": [
        "packages/sangfor-loop/src/executors/gap-queries.ts"
      ],
      "reads": [
        "data/feedback"
      ],
      "writes": [
        "data/sources/gap-queries.json"
      ]
    },
    {
      "id": "learn-sources",
      "kind": "script",
      "run": "learn:sources",
      "reads": [
        "data/sources/gap-queries.json",
        "data/runtime",
        "data/feedback"
      ],
      "writes": [],
      "note": "executor queues gap terms and surfaces the KB collector precondition. The outbound crawl (which writes data/sources/raw + data/rag/index.json) runs via the learn:sources script behind SANGFOR_LOOP_AUTO_COLLECT=1 and still needs glass CDP for the KB half.",
      "src": [
        "packages/sangfor-loop/src/executors/learn-sources.ts"
      ]
    },
    {
      "id": "embedding-drift",
      "kind": "internal",
      "src": [
        "packages/sangfor-loop/src/executors/embedding-drift.ts"
      ],
      "reads": [
        "data/rag/index.json"
      ],
      "writes": [
        "data/runtime/needs-reembed.flag"
      ]
    },
    {
      "id": "rag-eval",
      "kind": "internal",
      "src": [
        "packages/sangfor-loop/src/executors/rag-eval.ts",
        "packages/sangfor-evals/src/index.ts"
      ],
      "reads": [
        "data/evals"
      ],
      "writes": [],
      "note": "the rag index itself is the e4 trigger watch, not a direct read of this executor"
    }
  ],
  "edges": [
    {
      "id": "e1-gaps-to-queries",
      "from": "search-gap-capture",
      "to": "gap-queries",
      "on": "new-jsonl-lines",
      "watch": "data/feedback/search-gaps.jsonl"
    },
    {
      "id": "e2-queries-to-learn",
      "from": "gap-queries",
      "to": "learn-sources",
      "on": "file-changed",
      "watch": "data/sources/gap-queries.json"
    },
    {
      "id": "e3-drift-check",
      "from": "learn-sources",
      "to": "embedding-drift",
      "on": "every-tick"
    },
    {
      "id": "e4-index-to-eval",
      "from": "learn-sources",
      "to": "rag-eval",
      "on": "file-changed",
      "watch": "data/rag/index.json"
    }
  ]
}
